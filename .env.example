OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional stronger model used only for ambiguous/context-sensitive segments.
OLLAMA_FALLBACK_MODEL=
SOURCE_LANG=en
TARGET_LANG=id
TRANSLATION_DOMAIN=food_science

# Local laptop performance defaults.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_RETRIES=1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# Batched translation defaults.
TRANSLATION_BATCH_ENABLED=true
TRANSLATION_BATCH_SIZE=8
TRANSLATION_BATCH_MAX_CHARS=6000
OLLAMA_BATCH_NUM_PREDICT=1024

# Phase 5.1.6 context intelligence.
CONTEXT_FALLBACK_ENABLED=true
# Keep false by default so literal contextless TM from older phases does not contaminate 5.1.6.
CONTEXT_ALLOW_LEGACY_TM=false

PROMPT_VERSION=phase5165-v1
TERMINOLOGY_FILE=terminology.yaml
STANDARD_TERMINOLOGY_FILE=food_science_standards.yaml
STATE_DB=.translator_state/phase5165.db
TM_DB=.translator_state/translation_memory.db
CACHE_DB=.translator_state/translation_cache.db

INPUT_DIR=input
OUTPUT_DIR=output
